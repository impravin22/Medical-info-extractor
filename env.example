# Medical Summary Builder Configuration
# Copy this file to .env and fill in your actual values

# LLM Backend Selection (nebius, gemini, or hf)
MSB_LLM_BACKEND=nebius

# Nebius API Configuration (Primary - Hermes-4-405B)
MSB_NEBIUS_API_KEY=your_nebius_api_key_here
MSB_NEBIUS_MODEL=NousResearch/Hermes-4-405B
MSB_NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# Gemini API Configuration (Fallback)
MSB_GEMINI_API_KEY=your_google_gemini_api_key_here
MSB_GEMINI_MODEL=gemini-1.5-flash

# Alternative: Hugging Face Local Models (if using MSB_LLM_BACKEND=hf)
# MSB_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

