# Medical Summary Builder Configuration
# Copy this file to .env and fill in your actual values

# LLM Backend Selection (gemini or hf)
MSB_LLM_BACKEND=gemini

# Gemini API Configuration
MSB_GEMINI_API_KEY=your_google_gemini_api_key_here
MSB_GEMINI_MODEL=gemini-2.5-flash

# Alternative: Hugging Face Local Models (if using MSB_LLM_BACKEND=hf)
# MSB_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

